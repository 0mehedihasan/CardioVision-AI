# ==================================================
# CardioVision AI
# ==================================================

# ---- Python ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- Node / frontend ----
frontend/node_modules/
frontend/dist/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Environment ----
# .env holds the operator password when it is overridden. .env.example is
# committed and is the file to read; .env itself never is.
.env
.env.*
!.env.example

# ---- Large weights ----
#
# The three trained checkpoints ARE tracked, via Git LFS — see .gitattributes.
# They are what makes this repo runnable, so ignoring *.pt / *.pth here would
# silently defeat the LFS configuration and leave a clone that installs
# cleanly and then cannot load a model.
#
# MedGemma is different: 8.6 GB of vendor weights that belong to Google and are
# a `huggingface-cli download` away, so the directory stays out of the repo.
models/medgemma-1.5-4b-it/
*.safetensors
*.bin

# ---- Patient data ----
#
# data/.gitignore covers the database and per-case files. This entry keeps the
# top level honest for anything else written there at runtime.
!data/.gitignore
!data/sample/

# ---- Local Claude state ----
#
# .claude/ itself IS tracked: it is shared project context. This one subdirectory
# is for anything local or private, so it never becomes part of the repository.
.claude/local/
